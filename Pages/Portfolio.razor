@page "/portfolio"
@inject IJSRuntime JS

<PageTitle>Portfolio — Still Waters Fine Line Tattoo</PageTitle>

<section class="section">
    <div class="section-inner center reveal max-prose mx-auto">
        <span class="eyebrow">Portfolio</span>
        <h1>A Look at the Work</h1>
        <p class="lede">A small sample of completed pieces. Every tattoo is designed from scratch for the person wearing it. Hover an image to see its style.</p>
    </div>
</section>

<section class="section tone-deep">
    <div class="section-inner">
        <div class="gallery-flow reveal">
            <figure>
                <div class="photo-frame portfolio-photo" style="aspect-ratio: 405 / 480;">
                    <div class="photo-frame-clip"><img src="Assets/Photos/Portfolio/goose.jpg" alt="Fine-line goose tattoo on the forearm" loading="lazy" /></div>
                    <span class="style-tag">Fine Line</span>
                </div>
                <figcaption class="gallery-caption">forearm goose</figcaption>
            </figure>
            <figure>
                <div class="photo-frame portfolio-photo" style="aspect-ratio: 451 / 344;">
                    <div class="photo-frame-clip"><img src="Assets/Photos/Portfolio/desert-mountains.jpg" alt="Fine-line desert cactus and mountain landscape tattoo on the ribs" loading="lazy" /></div>
                    <span class="style-tag">Botanical</span>
                </div>
                <figcaption class="gallery-caption">desert ribs piece</figcaption>
            </figure>
            <figure>
                <div class="photo-frame portfolio-photo" style="aspect-ratio: 900 / 724;">
                    <div class="photo-frame-clip"><img src="Assets/Photos/Portfolio/wave-turtle.jpg" alt="Fine-line ocean wave and sea turtle tattoo on the ankle" loading="lazy" /></div>
                    <span class="style-tag">Fine Line</span>
                </div>
                <figcaption class="gallery-caption">ankle wave &amp; turtle</figcaption>
            </figure>
        </div>
    </div>
</section>

<WaveDivider Fill="var(--cream)" Flip="true" />

<section id="flash" class="section">
    <div class="section-inner">
        <div class="section-head center">
            <span class="eyebrow">Flash</span>
            <h2>Available Designs</h2>
            <p class="lede">A page of ready-to-book flash &mdash; pick one as-is, or let it inspire something custom.</p>
        </div>
        <div class="flash-sheet reveal">
            <div class="flash-item"><TabithaFlowerArt /><span class="flash-label">01</span></div>
            <div class="flash-item"><SprigArt /><span class="flash-label">02</span></div>
            <div class="flash-item"><FeatherArt /><span class="flash-label">03</span></div>
            <div class="flash-item"><ScriptWordArt Word="love" /><span class="flash-label">04</span></div>
            <div class="flash-item"><SparkleArt /><span class="flash-label">05</span></div>
            <div class="flash-item"><DragonflyArt /><span class="flash-label">06</span></div>
            <div class="flash-item"><DesertArt /><span class="flash-label">07</span></div>
            <div class="flash-item"><MicroMachineArt /><span class="flash-label">08</span></div>
            <div class="flash-item"><HeartArt /><span class="flash-label">09</span></div>
            <div class="flash-item"><ButterflyArt /><span class="flash-label">10</span></div>
            <div class="flash-item"><InfinityArt /><span class="flash-label">11</span></div>
            <div class="flash-item"><CrownArt /><span class="flash-label">12</span></div>
            <div class="flash-item"><RoseArt /><span class="flash-label">13</span></div>
            <div class="flash-item"><WaveIconArt /><span class="flash-label">14</span></div>
            <div class="flash-item"><TurtleArt /><span class="flash-label">15</span></div>
        </div>
        <p class="flash-invite">See one you like? Reach out and let&rsquo;s get it booked.</p>
        <div class="center mt-lg">
            <a class="ink-link" href="/book">Request This Piece <span class="arrow">&rarr;</span></a>
        </div>
    </div>
</section>

<section class="section">
    <div class="section-inner">
        <div class="split reveal">
            <div class="split-media">
                <div class="gallery-flow">
                    <figure>
                        <div class="ink-frame blob-2 size-md"><BrowArt /><span class="style-tag">PMU Brows</span></div>
                        <figcaption class="gallery-caption">left brow</figcaption>
                    </figure>
                    <figure>
                        <div class="ink-frame blob-4 size-md mirror"><BrowArt /><span class="style-tag">PMU Brows</span></div>
                        <figcaption class="gallery-caption">right brow</figcaption>
                    </figure>
                </div>
            </div>
            <div>
                <span class="eyebrow">Permanent Makeup</span>
                <h2>Brows, Done With Precision</h2>
                <p class="lede">Fine-line PMU brow work &mdash; natural, hair-stroke detail built to soften and define. Each set is custom-mapped to your natural brow shape, growth pattern, and face, for a result that looks like your brows, only fuller.</p>
                <ul class="pmu-pricing">
                    <li><span class="pmu-label">First Session</span><span class="pmu-price">$375</span></li>
                    <li><span class="pmu-label">30-Day Touch-Up</span><span class="pmu-price">$125</span></li>
                </ul>
            </div>
        </div>

        <div class="center mt-lg">
            <a class="ink-link" href="/book">Request Your Piece <span class="arrow">&rarr;</span></a>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("site.initReveal");
        }
    }
}
