@page "/portfolio"
@inject IJSRuntime JS

<PageTitle>Portfolio — Still Waters Fine Line Tattoo</PageTitle>

<section class="section">
    <div class="section-inner center reveal max-prose mx-auto">
        <span class="eyebrow">Portfolio</span>
        <h1>A Look at the Work</h1>
        <p class="lede">A small sample of completed pieces. Every tattoo is designed from scratch for the person wearing it.</p>
    </div>
</section>

<section class="section tone-deep">
    <div class="section-inner">
        <div class="gallery-flow reveal">
            <figure class="portfolio-figure">
                <ZoomableImage Src="Assets/Photos/Portfolio/goose.jpg" Alt="Fine-line goose tattoo on the forearm">
                    <div class="photo-frame portfolio-photo" style="aspect-ratio: 430 / 510;">
                        <div class="photo-frame-clip"><img src="Assets/Photos/Portfolio/goose.jpg" alt="Fine-line goose tattoo on the forearm" loading="lazy" /></div>
                    </div>
                </ZoomableImage>
            </figure>
            <figure class="portfolio-figure">
                <ZoomableImage Src="Assets/Photos/Portfolio/desert-mountains.jpg" Alt="Fine-line desert cactus and mountain landscape tattoo on the ribs">
                    <div class="photo-frame portfolio-photo" style="aspect-ratio: 451 / 344;">
                        <div class="photo-frame-clip"><img src="Assets/Photos/Portfolio/desert-mountains.jpg" alt="Fine-line desert cactus and mountain landscape tattoo on the ribs" loading="lazy" /></div>
                    </div>
                </ZoomableImage>
            </figure>
            <figure class="portfolio-figure">
                <ZoomableImage Src="Assets/Photos/Portfolio/wave-turtle.jpg" Alt="Fine-line ocean wave and sea turtle tattoo on the ankle">
                    <div class="photo-frame portfolio-photo" style="aspect-ratio: 900 / 724;">
                        <div class="photo-frame-clip"><img src="Assets/Photos/Portfolio/wave-turtle.jpg" alt="Fine-line ocean wave and sea turtle tattoo on the ankle" loading="lazy" /></div>
                    </div>
                </ZoomableImage>
            </figure>
        </div>
    </div>
</section>

<WaveDivider Fill="var(--cream)" Flip="true" />

<section id="flash" class="section">
    <div class="section-inner">
        <div class="section-head center">
            <span class="eyebrow">Flash</span>
            <h2>Available Designs</h2>
            <p class="lede">A page of ready-to-book flash &mdash; pick one as-is, or let it inspire something custom.</p>
        </div>

        <div class="flash-sale reveal">
            <span class="eyebrow">Friday, October 30</span>
            <h3 class="flash-sale-title">$50 Flash Friday</h3>
            <p class="flash-sale-deal">Tiny tattoos <strong>$30</strong> on the 30th &mdash; or <strong>2 for $50</strong></p>
            <p class="flash-sale-note">
                By appointment only. If you want a tiny tattoo not shown, let me know when booking
                and I&rsquo;ll include it! Stencils will be pre-sized and ready to go.
            </p>
            <a class="ink-link" href="/book">Book Flash Friday <span class="arrow">&rarr;</span></a>
        </div>
        <div class="flash-gallery reveal">
            <figure class="flash-sheet-figure">
                <ZoomableImage Src="Assets/Photos/Flash/flash-tiny-grid.jpg" Alt="Flash sheet of tiny tattoo designs including a ghost, cherries, angel numbers, a crown, paw print, wings and a four-leaf clover">
                    <div class="flash-sheet-photo"><img src="Assets/Photos/Flash/flash-tiny-grid.jpg" alt="Flash sheet of tiny tattoo designs including a ghost, cherries, angel numbers, a crown, paw print, wings and a four-leaf clover" loading="lazy" /></div>
                </ZoomableImage>
            </figure>
            <figure class="flash-sheet-figure">
                <ZoomableImage Src="Assets/Photos/Flash/flash-tiny-hearts.jpg" Alt="Flash sheet of tiny hearts, butterflies, a cross, crown, clover and script words including smile, love and art">
                    <div class="flash-sheet-photo"><img src="Assets/Photos/Flash/flash-tiny-hearts.jpg" alt="Flash sheet of tiny hearts, butterflies, a cross, crown, clover and script words including smile, love and art" loading="lazy" /></div>
                </ZoomableImage>
            </figure>
            <figure class="flash-sheet-figure">
                <ZoomableImage Src="Assets/Photos/Flash/flash-tiny-lineart.jpg" Alt="Flash sheet of single-line tiny tattoos including cats, a dog, roses, a guitar, sea turtle, hummingbird and lotus">
                    <div class="flash-sheet-photo"><img src="Assets/Photos/Flash/flash-tiny-lineart.jpg" alt="Flash sheet of single-line tiny tattoos including cats, a dog, roses, a guitar, sea turtle, hummingbird and lotus" loading="lazy" /></div>
                </ZoomableImage>
            </figure>
            <figure class="flash-sheet-figure">
                <ZoomableImage Src="Assets/Photos/Flash/flash-tiny-symbols.jpg" Alt="Flash sheet of tiny symbols including a plumeria, diamond, bunny, lightning bolt, lotus, hibiscus, flamingo, sea turtle and LOVE lettering">
                    <div class="flash-sheet-photo"><img src="Assets/Photos/Flash/flash-tiny-symbols.jpg" alt="Flash sheet of tiny symbols including a plumeria, diamond, bunny, lightning bolt, lotus, hibiscus, flamingo, sea turtle and LOVE lettering" loading="lazy" /></div>
                </ZoomableImage>
            </figure>
        </div>
        <p class="flash-invite">See one you like? Reach out and let&rsquo;s get it booked.</p>
        <div class="center mt-lg">
            <a class="ink-link" href="/book">Request This Piece <span class="arrow">&rarr;</span></a>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("site.initReveal");
        }
    }
}
