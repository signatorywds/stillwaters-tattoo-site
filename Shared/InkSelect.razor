@namespace StillWatersTattoo.Shared

<div class="ink-select @(_open ? "open" : "")" @onkeydown="HandleKeyDown">
    <button type="button" class="ink-select-trigger" @onclick="Toggle">
        <span>@Value</span>
        <svg class="ink-select-chevron" viewBox="0 0 20 20"><polyline points="5 8 10 13 15 8" /></svg>
    </button>

    <div class="ink-select-scrim @(_open ? "open" : "")" @onclick="Close"></div>

    <ul class="ink-select-panel @(_open ? "open" : "")">
        @foreach (var option in Options)
        {
            <li>
                <button type="button" class="@(option == Value ? "selected" : "")" @onclick="() => Select(option)">
                    <span class="ink-select-gem"></span>@option
                </button>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IEnumerable<string> Options { get; set; } = Array.Empty<string>();

    private bool _open;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private async Task Select(string option)
    {
        _open = false;
        if (option != Value)
        {
            Value = option;
            await ValueChanged.InvokeAsync(option);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
        else if (e.Key == "ArrowDown" && !_open)
        {
            _open = true;
        }
    }
}
